# Link and start with:
#   systemctl --user link "$PWD/deploy/claude-web-youtube-connector.service"
#   systemctl --user enable --now claude-web-youtube-connector
# PUBLIC_URL goes in ~/.config/claude-web-youtube-connector/env, for example
#   PUBLIC_URL=https://machine.example.ts.net
[Unit]
Description=YouTube connector for Claude on the web
After=network-online.target

[Service]
WorkingDirectory=%h/work_with_youtube_skill_for_claude_code/claude-web-youtube-connector
EnvironmentFile=%h/.config/claude-web-youtube-connector/env
Environment=PYTHON=/usr/bin/python3
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
