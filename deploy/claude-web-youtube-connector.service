# A template: the README's install step replaces @REPO@ with the repository's
# path and writes the result to ~/.config/systemd/user/.
[Unit]
Description=YouTube connector for Claude on the web
After=network-online.target

[Service]
WorkingDirectory=@REPO@
EnvironmentFile=%h/.config/claude-web-youtube-connector/env
ExecStart=/usr/bin/env node src/server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
